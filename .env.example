# Copy to .env and fill in. `docker compose up` reads this file automatically.
#
#   cp .env.example .env
#
# Generate the two secrets:
#   ADMIN_TOKEN=$(openssl rand -base64 32)
#   SECRET_ENCRYPTION_KEY=$(openssl rand -base64 32)

# ---------------------------------------------------------------------------
# Required — the API refuses to start without these.
# ---------------------------------------------------------------------------

# Bearer token guarding the whole admin API. Minimum 16 characters.
ADMIN_TOKEN=

# Encrypts listener secrets and service link tokens at rest (AES-256-GCM).
# Must decode to exactly 32 bytes. Changing it makes existing secrets
# unreadable, so treat it as permanent once you have data.
SECRET_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

POSTGRES_USER=hookfan
POSTGRES_PASSWORD=hookfan
POSTGRES_DB=hookfan

# DATABASE_URL is assembled from the three values above inside compose. Set it
# directly only when pointing at a database outside this compose file.
# DATABASE_URL=postgres://hookfan:hookfan@db:5432/hookfan?sslmode=disable

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Host port for the API. This is the one that must be reachable from the public
# internet, because Meta posts webhooks to it.
API_PORT=8081

# Host port for the web UI. Can stay internal or behind your own ingress.
UI_PORT=8080

# Browser-reachable address of the API. This is the mistake everyone makes
# first: it must be the address YOUR BROWSER can reach, not the compose service
# name. `http://api:8081` resolves only inside the compose network, and the
# request originates in your browser, so it will fail.
#   Local:      http://localhost:8081
#   Deployed:   https://hookfan-api.example.com
API_BASE_URL=http://localhost:8081

# Comma-separated origins allowed to call the admin API from a browser.
# Must match wherever you serve the UI from. Defaults to denying everything;
# "*" is rejected, since the admin API carries a bearer token.
ALLOWED_ORIGINS=http://localhost:8080

# ---------------------------------------------------------------------------
# Tuning — every one of these has a sane default.
# ---------------------------------------------------------------------------

# Delivery worker goroutines. Default 16.
WORKER_CONCURRENCY=16

# Events and their deliveries are purged after this many days. Default 30.
EVENT_RETENTION_DAYS=30

# Allow forwarding to loopback / link-local / RFC1918 addresses. Compose sets
# this to true because your backend services live on the compose network. Set
# it to false in an environment where targets should be public addresses only.
ALLOW_PRIVATE_TARGETS=true

# debug | info | warn | error
LOG_LEVEL=info
